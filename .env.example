# Enables real LLM-backed QC and plan generation.
GEMINI_API_KEY=

# Optional: override model for QC (step 2). Default: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Optional: override model for plan generation (step 3). Default: gemini-3.1-pro-preview
PLAN_MODEL=gemini-3.1-pro-preview

# AG2 API KEY
AG2_API_KEY=

# Plan-generation sidecar (AG2 service in agents/). Default points at the
# uvicorn dev server started by `npm run dev:full`.
PLAN_SERVICE_URL=http://127.0.0.1:8001
PLAN_SERVICE_TIMEOUT_MS=60000

